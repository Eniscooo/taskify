// Naija Market database schema.
//
// Conventions:
// - Table and column names are snake_case in Postgres (@@map / @map).
// - Money is stored as BigInt kobo (₦1 = 100 kobo), matching Paystack.
// - Every column used for filtering or sorting is indexed.
//
// So far this covers accounts, auth and the P2P marketplace. Services,
// tasks, orders, payments, ledger, messaging, reviews and disputes are added
// in their own migrations as each module is built.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

enum UploadStatus {
  pending
  ready
  attached

  @@map("upload_status")
}

enum ListingStatus {
  draft
  active
  sold
  flagged
  removed

  @@map("listing_status")
}

enum ListingCondition {
  new
  like_new
  used_good
  used_fair

  @@map("listing_condition")
}

enum DeliveryMethod {
  pickup
  seller_delivers
  both

  @@map("delivery_method")
}

// Accounts. User, Session, Account and Verification are managed by Better
// Auth (src/auth). Its field names are mapped in auth.ts: `phoneNumber` is
// `phone` and `phoneNumberVerified` is `phoneVerified`.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  // Generated from the name at sign-up; used in public profile URLs.
  username      String     @unique
  name          String
  // E.164, e.g. +2348034127790.
  phone         String     @unique
  phoneVerified Boolean    @default(false) @map("phone_verified")
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  idVerifiedAt  DateTime?  @map("id_verified_at")
  // Default location; set from the profile after sign-up.
  area          String?
  bio           String?
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  listings Listing[]
  sessions Session[]
  accounts Account[]
  uploads  MediaUpload[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// A sign-in method for a user. Password logins use providerId "credential"
// with a scrypt hash in `password`; social logins would add rows here.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Short-lived one-time codes (SMS OTPs, password reset codes).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listings Listing[]

  @@map("categories")
}

// Drafts can be saved half-filled, so category, condition and delivery may
// be null and the other details empty. Publishing requires all of them (see
// ListingsService), so active and sold listings are always complete.
model Listing {
  id          String            @id @default(uuid(7)) @db.Uuid
  sellerId    String            @map("seller_id") @db.Uuid
  categoryId  String?           @map("category_id") @db.Uuid
  title       String
  description String            @default("")
  priceKobo   BigInt            @default(0) @map("price_kobo")
  // Seller is open to offers.
  negotiable  Boolean           @default(true)
  condition   ListingCondition?
  delivery    DeliveryMethod?
  area        String            @default("")
  // Approximate pickup point; becomes a PostGIS geography column when
  // radius search is added.
  latitude    Decimal?          @db.Decimal(9, 6)
  longitude   Decimal?          @db.Decimal(9, 6)
  status      ListingStatus     @default(draft)
  views       Int               @default(0)
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  seller   User           @relation(fields: [sellerId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ListingImage[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, categoryId])
  @@index([status, area])
  @@index([status, priceKobo])
  @@index([status, views(sort: Desc)])
  @@index([sellerId])
  @@map("listings")
}

model ListingImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  // Object key in R2/S3; the CDN URL is built from this.
  storageKey String   @map("storage_key")
  position   Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@map("listing_images")
}

// A photo upload. The browser puts the original at incomingKey (private)
// using a signed URL from the API; the API then re-encodes it to `key`
// (public) and deletes the original. Postgres is the record of who owns which
// object, so listings can only use their seller's ready uploads.
model MediaUpload {
  id          String       @id @default(uuid(7)) @db.Uuid
  ownerId     String       @map("owner_id") @db.Uuid
  status      UploadStatus @default(pending)
  incomingKey String       @unique @map("incoming_key")
  contentType String       @map("content_type")
  bytes       Int
  key         String?      @unique
  width       Int?
  height      Int?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("media_uploads")
}
