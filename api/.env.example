NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Local Postgres started by `npm run services`
DATABASE_URL=postgresql://naija:naija_dev_password@localhost:5432/naija_market

# Local Redis started by `npm run services`
REDIS_URL=redis://localhost:6379

# Public CDN base URL for listing photos (Cloudflare R2)
MEDIA_BASE_URL=https://media.naijamarket.ng
