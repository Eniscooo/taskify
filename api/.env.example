NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Local Postgres started by `npm run services`
DATABASE_URL=postgresql://naija:naija_dev_password@localhost:5432/naija_market

# Local Redis started by `npm run services`
REDIS_URL=redis://localhost:6379

# Photo storage. "local" keeps files in .data/media and imitates R2's signed
# upload URLs (development). "r2" uses Cloudflare R2: create a bucket, connect
# a custom domain for public reads, create an R2 API token with read and
# write access to that bucket, fill these in, then run `npm run r2:setup`.
MEDIA_STORAGE=local
# Public base URL for photos: http://localhost:4000/media locally, or the
# bucket's custom domain with R2, e.g. https://media.naijamarket.ng
MEDIA_BASE_URL=http://localhost:4000/media
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=naija-market-media

# Better Auth (sessions, sign-in, OTP)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
# Parent domain for the session cookie in production, e.g. naijamarket.ng
# COOKIE_DOMAIN=naijamarket.ng
# "console" logs OTP codes instead of texting them (development only)
SMS_PROVIDER=console
# Number of reverse proxies in front of the API (load balancer = 1)
# TRUST_PROXY_HOPS=1

# Email. "console" logs emails instead of sending them (development only).
# To send for real: EMAIL_PROVIDER=resend, plus your Resend API key and a
# sender on a domain you've verified in Resend.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_...
# EMAIL_FROM=Naija Market <no-reply@naijamarket.ng>
